{
  "manifest_version": 3,
  "name": "Strong Password Vault (Beta)",
  "version": "0.2.0",
  "description": "Beta: generate strong passwords and keep them in a local encrypted vault.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "Strong Password Vault",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
